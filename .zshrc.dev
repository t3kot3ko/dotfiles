# Partial zshrc to build development enviroment
# Suppose asdf has been activated in this script

## Android
# export ANDROID_HOME=/opt/android-sdk-linux
export ANDROID_HOME=$HOME/Library/Android/sdk
export ANDROID_STUDIO_HOME=/opt/android-studio


if [ -d $ANDROID_HOME ]; then
  export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin
  export PATH=$PATH:$ANDROID_HOME/tools
  export PATH=$PATH:$ANDROID_HOME/platform-tools
  export PATH=$PATH:$ANDROID_HOME/emulator
  export PATH=$PATH:$ANDROID_HOME/tools/bin
  export ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/28.2.13676358
  export ANDROID_NDK_ROOT=${ANDROID_HOME}/ndk/28.2.13676358

  # Latest build-tools
  latest=$(ls ${ANDROID_HOME}/build-tools | tail -n1)
  export PATH=$PATH:${ANDROID_HOME}/build-tools/${latest}
elif [ -d $ANDROID_STUDIO_HOME ]; then
  export PATH=$PATH:$ANDROID_STUDIO_HOME/bin
  export PATH=$PATH:$ANDROID_STUDIO_HOME/sdk/platform-tools
  alias studio="studio.sh &"
fi

### NDK
export ANDROID_NDK_HOME=/opt/android-ndk-linux
if [ -d $ANDROID_NDK_HOME ]; then
  export PATH=$PATH:$ANDROID_NDK_HOME
fi

## direnv
if $(whence direnv > /dev/null); then
  eval "$(direnv hook zsh)"
fi

## Java
if $(whence java 2>&1 > /dev/null); then
    # Automatically set JAVA_HOME
    if [[ -e $HOME/.asdf/plugins/java/set-java-home.zsh ]]; then
        . $HOME/.asdf/plugins/java/set-java-home.zsh
    fi
fi

## Rust
if [ -d $HOME/.cargo ]; then
  source $HOME/.cargo/env
fi

## sdkman
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

## homebrew (linux)
if [[ $(uname) == "Linux" ]]; then
  if $(whence /home/linuxbrew/.linuxbrew/bin/brew >/dev/null); then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
fi

## GitHub CLI
if $(whence gh > /dev/null); then
  eval "$(gh completion -s zsh)"
fi

