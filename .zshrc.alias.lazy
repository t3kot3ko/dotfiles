# Use Rust command line tools (eza - modern ls replacement)
if (( $+commands[eza] )); then
	alias ls="eza"
	alias ll="eza -la --git --icons"
	alias la="eza -a --icons"
	alias lt="eza --tree --level=2 --icons"
	alias l="eza -l --icons"
fi

if (( $+commands[fd] )); then
	alias find="fd"
fi

if (( $+commands[delta] )); then
	alias diff="delta"
fi

if (( $+commands[rg] )); then
	alias grep="rg"
fi


# Use xdg-open as "open" for Linux
if [[ $OSTYPE == linux* ]]; then
	if (( $+commands[xdg-open] )); then
		alias open=xdg-open
	fi
fi

if (( $+commands[bat] )); then
	alias b="bat"
elif (( $+commands[batcat] )); then
	alias b="batcat"
else
	alias b="cat"
fi

# jq
if (( $+commands[jq] )); then
	alias jqd="jq ."
fi

# extract
if (( $+functions[extract] )); then  # zsh-extract プラグインの関数
	alias x=extract
fi


# vim/nvim
if (( $+commands[nvim] )); then
	alias vim=nvim
	export EDITOR=nvim
fi
