## fzf configuration
# Use fd for faster file searching
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# Preview with bat
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {} | head -200'"

# fzf 本体のキーバインド・補完（Ctrl-T: ファイル挿入, Alt-C: cd, `vim **<Tab>` などの ** 補完）
#   Ctrl-R は atuin を使うため空にして無効化する（空文字のときだけ fzf は Ctrl-R を割り当てない）
#   tmux の prefix が C-t で、Ghostty は Option を Alt として送らないため、^L f / ^L d からも呼べるようにしている（下の dispatcher）
FZF_CTRL_R_COMMAND=
source <(fzf --zsh)

## Colorscheme
export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS'
--color=dark
--color=fg:-1,bg:-1,hl:#569fba 
--color=fg+:-1,bg+:-1,hl+:#65b1cd 
--color=info:#f6c177,prompt:#65b1cd,pointer:#a6dae3 
--color=marker:#b1d196,spinner:#ccb1ed,header:#a3be8c'

## files
function show_buffer_stack() {
	POSTDISPLAY="
	stack: $LBUFFER"
	zle push-line-or-edit
}
zle -N show_buffer_stack
setopt noflowcontrol
bindkey '^Q' show_buffer_stack

## ghq
function fzf-src () {
  local selected_dir=$(ghq list -p | fzf --query "$LBUFFER")
  if [ -n "$selected_dir" ]; then
    BUFFER="cd ${selected_dir}"
    zle accept-line
  fi
  zle clear-screen
}
zle -N fzf-src
bindkey '^]' fzf-src

function fzf-src-show () {
  local selected_dir=$(ghq list -p | fzf )
  if [ -n "$selected_dir" ]; then
    BUFFER="$LBUFFER${selected_dir}$RBUFFER"
    CURSOR=$#BUFFER
  fi
}
zle -N fzf-src-show


# grep は rg のエイリアスになるため command grep を使う（rr で再読み込みすると関数内のエイリアスが展開されるので）
function fzf-git-branch () {
  local selected_dir=$(git branch | command grep -v "*" | command grep -v "\->" | sed -e "s/^[ ]*//g" | fzf )
  if [ -n "$selected_dir" ]; then
    BUFFER="$LBUFFER${selected_dir}"
    CURSOR=$#BUFFER
  fi
}
zle -N fzf-git-branch

function fzf-git-branch-all () {
  local selected_dir=$(git branch -a | command grep -v "*" | command grep -v "\->" | sed -e "s/^[ ]*//g" | fzf )
  if [ -n "$selected_dir" ]; then
    BUFFER="$LBUFFER${selected_dir}"
    CURSOR=$#BUFFER
  fi
}
zle -N fzf-git-branch-all


function fzf-git-checkout() {
  local selected=$(git branch -a | command grep -v '*' | sed -e "s/^\*[ ]*//g" | fzf)
  
  if git rev-parse 2> /dev/null; then
    if [ -n "$selected" ]; then
      BUFFER="git checkout ${selected}"
      zle accept-line
    fi
    zle clear-screen
  fi
}
zle -N fzf-git-checkout
bindkey '^kc' fzf-git-checkout

function fzf-git-cd-submodule () {
  local selected=$(git submodule | fzf)
  local dir=$(echo $selected | cut -d " " -f3)
  if git rev-parse 2> /dev/null; then
    if [ -n "$dir" ]; then
      cd ${dir}
      zle accept-line
    fi
    zle clear-screen
  fi
}
zle -N fzf-git-cd-submodule
bindkey '^ks' fzf-git-cd-submodule

## Select history (commented out in favor of atuin)
# function fzf-select-history() {
#     BUFFER=$(fc -l -r -n 1 | fzf --query "$LBUFFER" --prompt "History > ")
#     CURSOR=$#BUFFER
#     zle redisplay
# }
# zle -N fzf-select-history
# bindkey '^r' fzf-select-history

bindkey '^p' history-beginning-search-backward
bindkey '^n' history-beginning-search-forward

function fzf-ls-file() {
    # selected_files=$(echo $source_files | fzf --prompt "Files > ")
    # $(...) の中のエイリアスは実行時に展開されるため、ls が eza になる。eza は標準入力が端末でないと
    # そこからパスを読もうとし、ウィジェットの中では何も表示しないので、エイリアスを使わない
    selected_files=$(command ls | fzf --prompt "Files > ")

    # BUFFER="${BUFFER}${echo $selected_files | tr '\n' ' '}"
    BUFFER="${BUFFER}$selected_files"
    CURSOR=$#BUFFER
    zle redisplay
}
zle -N fzf-ls-file

## SSH
#
function fzf-ssh () {
  local selected_host=$(awk '
  tolower($1)=="host" {
    for (i=2; i<=NF; i++) {
      if ($i !~ "[*?]") {
        print $i
      }
    }
  }
  ' ~/.ssh/config | sort | fzf --query "$LBUFFER" --prompt "SSH to: ")
  if [ -n "$selected_host" ]; then
    BUFFER="ssh ${selected_host}"
    zle accept-line
  fi
  zle clear-screen
}
zle -N fzf-ssh
bindkey '^s' fzf-ssh


## Select history
function fzf-kill() {
    BUFFER=$(ps aux | fzf -m | awk '{print $2}' | xargs kill -9)
    CURSOR=$#BUFFER
    zle redisplay
}
zle -N fzf-kill
bindkey '^k^k' fzf-kill

function fzf-select-docker-container() {
  selected=$(docker container ls | fzf --reverse --multi --header-lines=1 | awk '{print $1}')
  BUFFER="$LBUFFER${selected}"
  CURSOR=$#BUFFER
  zle redisplay

}
zle -N fzf-select-docker-container

function fzf-cdr() {
    local selected_dir=$(cdr -l | awk '{ print $2 }' | fzf)
    if [ -n "$selected_dir" ]; then
        BUFFER="cd ${selected_dir}"
        zle accept-line
    fi
    zle clear-screen
}
zle -N fzf-cdr

## Ctrl-L leader key dispatcher
# ^L 単体は clear-screen とプレフィックス衝突するため、KEYTIMEOUT(vi-mode Esc 用に短縮済み)
# に依存せず、専用のタイムアウトで次の1文字を判定してディスパッチする
function fzf-ctrl-l-dispatch() {
  local key
  read -k 1 -t 0.3 key
  case "$key" in
    r) zle fzf-src-show; return ;;
    b) zle fzf-git-branch; return ;;
    # B はグローバルエイリアス（.zshrc.alias）なので、クォートしないと関数の定義時に
    # `git branch | fzf ...` に展開され、case の判定のたびに fzf が起動してしまう
    'B') zle fzf-git-branch-all; return ;;
    s) zle fzf-ls-file; return ;;
    c) zle fzf-select-docker-container; return ;;
    h) zle fzf-cdr; return ;;
    f) zle fzf-file-widget; return ;;
    d) zle fzf-cd-widget; return ;;
  esac
  zle clear-screen
  [[ -n "$key" ]] && zle -U "$key"
}
zle -N fzf-ctrl-l-dispatch
bindkey '^L' fzf-ctrl-l-dispatch

function paste-current-git-branch() {
    local branch_name
    branch_name=$(git branch --show-current 2>/dev/null)
    if [ -n "$branch_name" ]; then
        BUFFER="$LBUFFER${branch_name}"
        CURSOR=$#BUFFER
    fi
}
zle -N paste-current-git-branch
bindkey '^kb' paste-current-git-branch
